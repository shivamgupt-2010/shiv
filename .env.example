# ==============================================================================
# ShivAI Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT YOUR .env FILE OR EXPOSE API KEYS.
# ==============================================================================

# Server Configuration
SHIVAI_ENV=development
SHIVAI_PORT=8000
SHIVAI_HOST=0.0.0.0
SHIVAI_DEBUG=false
SHIVAI_API_KEY=shivai-master-dev-key-change-in-production
SHIVAI_ALLOWED_ORIGINS=*

# Database Configuration
# Default SQLite async URL (zero configuration needed)
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/shivai
DATABASE_URL=sqlite+aiosqlite:///./shivai.db

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
REQUEST_TIMEOUT_SECONDS=60

# Model Provider API Keys
# Provide any 1, 2, or all 6 keys. ShivAI will automatically route, rotate, and fall back!
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Optional: Generic OpenAI-compatible provider (e.g. OpenRouter, Perplexity, Ollama, vLLM)
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
REDACT_SECRETS=true
